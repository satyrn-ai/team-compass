# ==========================================
# PYTHON ENVIRONMENT & CACHE
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (Standard & common tools)
.venv/
venv/
ENV/
env/
_venv/

# Pipenv, Poetry, and UV artifacts
.pipenv/
.poetry/
.uv/
# pixi environments
.pixi/*
!.pixi/config.toml

# ==========================================
# PYTHON PACKAGING & BUILDS
# ==========================================
# Distribution and installation artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==========================================
# TESTING & TESTING REPORTS
# ==========================================
# Inline coverage and unit test artifacts
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==========================================
# MARKDOWN & DOCUMENTATION BUILDS
# ==========================================
# HTML/PDF outputs generated from Markdown files
_build/
site/
*.html
*.pdf

# Exception: Keep markdown source files safe
!*.md

# ==========================================
# IDE & OPERATING SYSTEM TEMPORARY FILES
# ==========================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# PyCharm / IntelliJ
.idea/

# Operating System files
.DS_Store
Thumbs.db

# ==========================================
# ENV SECRETS (NEVER COMMITTED)
# ==========================================
.env
.env.local
*.secret
